pipeline {
    agent any
    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Select the deployment environment')
    }
    stages {
        stage('Checkout') {
            steps {
                // Replace with your exact GitHub Username and Repository Name
                git branch: 'main', url: 'https://github.com<YOUR-USERNAME>/<YOUR-REPO-NAME>.git'
            }
        }
        stage('Show Parameter') {
            steps {
                echo "Selected environment: ${params.ENVIRONMENT}"
            }
        }
        stage('Build for Environment') {
            steps {
                echo "Building the Online Examination System for the ${params.ENVIRONMENT} environment..."
            }
        }
    }
}
